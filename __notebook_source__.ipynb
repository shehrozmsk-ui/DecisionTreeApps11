import os
import zipfile

base = "/kaggle/working"
zip_path = base + "/starbucks_project_files.zip"

files_to_include = [
    "starbucks.csv",
    "decision_tree_model.joblib",
    "model_metadata.json",
    "outputs/decision_tree.png",
    "outputs/eda_report.txt",
]

with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for file in files_to_include:
        path = os.path.join(base, file)
        if os.path.isfile(path):
            z.write(path, arcname=file)
            print("Added:", file)
        else:
            print("Missing:", file)

print("ZIP created:", zip_path)

